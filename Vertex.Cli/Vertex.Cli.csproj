<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>vx</AssemblyName>
        <ApplicationIcon>vertex-icon.ico</ApplicationIcon>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
        <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
        <Optimize>True</Optimize>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
        <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
        <DebugSymbols>True</DebugSymbols>
        <DebugType>Full</DebugType>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Analyze|AnyCPU'">
        <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
        <RunAnalyzersDuringBuild>True</RunAnalyzersDuringBuild>
        <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="EntexInteractive.Extensions" Version="10.0.3"/>
        <PackageReference Include="Google.Protobuf" Version="3.35.1"/>
        <PackageReference Include="Grpc.Net.Client" Version="2.83.0" PrivateAssets="All"/>
        <PackageReference Include="Grpc.Tools" Version="2.83.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="System.CommandLine" Version="2.0.11" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Serilog" />
        <Using Include="System.CommandLine" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vertex.Core\Vertex.Core.csproj"/>
        <ProjectReference Include="..\Vertex.Net\Vertex.Net.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="..\Vertex.Server\Protos\Greeter.proto" Link="Protos\Greeter.proto" GrpcServices="Client"/>
        <Protobuf Include="..\Vertex.Server\Protos\Files.proto" Link="Protos\Files.proto" GrpcServices="Client"/>
    </ItemGroup>

</Project>
