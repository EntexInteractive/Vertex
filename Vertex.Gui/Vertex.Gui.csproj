<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Platforms>AnyCPU</Platforms>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Generate embedded file manifest when using the Photino.NET StaticFileServer -->
        <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
        <ApplicationIcon>vertex-icon.ico</ApplicationIcon>
        <AssemblyName>Vertex</AssemblyName>
        <AssemblyVersion>0.0.0.0</AssemblyVersion>
        <Company>Entex Interactive, LLC</Company>
        <Copyright>Copyright $(Company). All Rights Reserved.</Copyright>
        <FileVersion>$(AssemblyVersion)</FileVersion>
        <Version>$(VersionPrefix)$(AssemblyVersion)</Version>
        <Authors>$(Company)</Authors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="EntexInteractive.Extensions" Version="10.0.6"/>
        <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.34"/>
        <PackageReference Include="Photino.NET" Version="4.0.16"/>
        <PackageReference Include="Photino.NET.Server" Version="3.0.11"/>
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vertex.Core\Vertex.Core.csproj"/>
    </ItemGroup>

    <Import Project="..\Vertex.React.targets"/>
</Project>
