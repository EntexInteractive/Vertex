  "components": {
    "schemas": {
      "BranchDto": {
        "required": [
          "id",
          "name",
          "parentId",
          "mergeTo"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "parentId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "mergeTo": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "ChangeDto": {
        "required": [
          "path",
          "kind",
          "previousPath",
          "size",
          "lockedBy",
          "serverChanged"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ChangeKind"
          },
          "previousPath": {
            "type": [
              "null",
              "string"
            ]
          },
          "size": {
            "type": "integer",
            "format": "int64"
          },
          "lockedBy": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LockHolderDto"
              }
            ]
          },
          "serverChanged": {
            "type": "boolean"
          }
        }
      },
      "ChangeKind": {
        "enum": [
          "Added",
          "Modified",
          "Deleted",
          "Moved"
        ]
      },
      "CheckoutRequest": {
        "required": [
          "branchId"
        ],
        "type": "object",
        "properties": {
          "branchId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CloneRequest": {
        "required": [
          "projectId",
          "folder",
          "branch"
        ],
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "folder": {
            "type": "string"
          },
          "branch": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "InitRequest": {
        "required": [
          "folder",
          "name",
          "template"
        ],
        "type": "object",
        "properties": {
          "folder": {
            "type": "string"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "template": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "LockDto": {
        "required": [
          "path",
          "username",
          "host",
          "mine",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "mine": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "LockHolderDto": {
        "required": [
          "username",
          "host",
          "sameUser"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "sameUser": {
            "type": "boolean"
          }
        }
      },
      "LoginRequestDto": {
        "required": [
          "server",
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "server": {
            "type": [
              "null",
              "string"
            ]
          },
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "OpenWorkspaceRequest": {
        "required": [
          "path"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        }
      },
      "OperationDto": {
        "required": [
          "id",
          "kind",
          "title",
          "step",
          "phases",
          "startedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "step": {
            "type": [
              "null",
              "string"
            ]
          },
          "phases": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PhaseDto"
            }
          },
          "startedAt": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "PathRequest": {
        "required": [
          "path"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        }
      },
      "PhaseDto": {
        "required": [
          "name",
          "unit",
          "done",
          "total",
          "started",
          "transferredBytes"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "unit": {
            "$ref": "#/components/schemas/PhaseUnit"
          },
          "done": {
            "type": "integer",
            "format": "int64"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "started": {
            "type": "boolean"
          },
          "transferredBytes": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "PhaseUnit": {
        "enum": [
          "Files",
          "Bytes"
        ]
      },
      "PickFolderRequest": {
        "required": [
          "title",
          "startIn"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "startIn": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PickFolderResponse": {
        "required": [
          "path"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProjectDto": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "RecentWorkspaceDto": {
        "required": [
          "root",
          "name",
          "project",
          "branch",
          "lastOpened",
          "exists"
        ],
        "type": "object",
        "properties": {
          "root": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "project": {
            "type": [
              "null",
              "string"
